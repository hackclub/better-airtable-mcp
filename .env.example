DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/better_airtable_mcp?sslmode=disable
BASE_URL=http://localhost:8080
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
# Must be exactly 32 bytes. This placeholder is for local dev only.
APP_ENCRYPTION_KEY=dev-only-change-me-0123456789abc
DUCKDB_DATA_DIR=./data/duckdb
PORT=8080

# Optional tunables (defaults shown)
APPROVAL_TTL_MINUTES=60
SYNC_INTERVAL_SECONDS=60
SYNC_TTL_MINUTES=10
QUERY_DEFAULT_LIMIT=100
QUERY_MAX_LIMIT=1000
